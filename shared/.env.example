# ─────────────────────────────────────────────────────────────────────
# Família agile-* — template do .env COMPARTILHADO
#
# Um único arquivo serve TODAS as skills `agile-*` deste repositório.
# Cada skill lê apenas as variáveis que precisa; sobra é ignorada.
#
# COMO USAR (não edite este arquivo com valores reais):
#   mkdir -p ~/.config/agile
#   cp shared/.env.example ~/.config/agile/.env
#   chmod 600 ~/.config/agile/.env
#   $EDITOR ~/.config/agile/.env
#
# Cada usuário gera as PRÓPRIAS credenciais — ver shared/README.md.
# NUNCA faça commit do .env preenchido nem de sa-key.json.
# ─────────────────────────────────────────────────────────────────────

# ===== Comum a toda a família agile-* (Azure DevOps) =====

# PAT de LEITURA — escopo Work Items (Read). Usado pela maioria das skills.
AZDO_PAT=COLE_SEU_TOKEN_DE_LEITURA_AQUI

# PAT de ESCRITA — escopo Work Items (Read & Write). Só skills que criam/editam
# work items. Deixe vazio se você só usa skills de leitura.
AZDO_PAT_WRITE=

# Organização e projeto no Azure DevOps.
AZDO_ORG=sua-organizacao
AZDO_PROJECT=seu-projeto

# Opcional — torna o cliente compartilhado importável em sessões interativas
# (REPL, scripts ad-hoc). As skills já se auto-localizam, então isto é extra.
# Ajuste o caminho ABSOLUTO para a pasta shared/ deste repositório na SUA máquina:
# export PYTHONPATH="$HOME/caminho/para/agentes-agilidade/shared:$PYTHONPATH"

# ===== Específico de agile-report-bugs (entrega Chat + Drive) =====

# Google Chat — Incoming Webhook do seu espaço.
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=...&token=...

# Google Drive — Service Account p/ upload headless.
GDRIVE_SA_JSON=$HOME/.config/agile/sa-key.json

# Google Drive — ID da pasta no seu Drive Compartilhado.
GDRIVE_FOLDER_ID=COLE_O_ID_DA_PASTA_AQUI

# Opcional — diretório de saída do PDF (default: diretório atual).
# REPORT_OUT_DIR=$HOME/Documents/Reports

# ===== Específico de agile-postmortem (entrega Drive + Chat/Teams) =====
# Reaproveita GDRIVE_SA_JSON e GCHAT_WEBHOOK_URL acima. Variáveis próprias:

# Google Doc template que será DUPLICADO a cada post mortem (passo 1).
# É o "/document/d/<ID>/edit" do Doc template no seu Drive.
PM_TEMPLATE_DOC_ID=COLE_O_ID_DO_DOC_TEMPLATE_AQUI

# Google Drive — ID da pasta compartilhada onde os post mortems são salvos
# (Doc nativo). Pode ser um Drive Compartilhado diferente do dos relatórios.
PM_DRIVE_FOLDER_ID=COLE_O_ID_DA_PASTA_DE_POSTMORTEMS_AQUI

# Opcional — Incoming Webhook de um canal do Microsoft Teams para notificar.
# TEAMS_WEBHOOK_URL=https://...
