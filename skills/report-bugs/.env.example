# ─────────────────────────────────────────────────────────────────────
# report-bugs — template de variáveis de ambiente
#
# COMO USAR (não edite este arquivo com valores reais):
#   mkdir -p ~/.config/report-bugs
#   cp .env.example ~/.config/report-bugs/.env
#   chmod 600 ~/.config/report-bugs/.env
#   $EDITOR ~/.config/report-bugs/.env
#
# Cada usuário gera as PRÓPRIAS credenciais — ver references/setup.md.
# NUNCA faça commit do .env preenchido.
# ─────────────────────────────────────────────────────────────────────

# Azure DevOps — Personal Access Token, escopo Work Items (Read)  [seção A]
AZDO_PAT=COLE_SEU_TOKEN_AQUI

# Azure DevOps — sua organização e projeto
AZDO_ORG=sua-organizacao
AZDO_PROJECT=seu-projeto

# Google Chat — Incoming Webhook do seu espaço  [seção B]
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=...&token=...

# Google Drive — Service Account p/ upload headless  [seção C]
GDRIVE_SA_JSON=$HOME/.config/report-bugs/sa-key.json

# Google Drive — ID da pasta no seu Drive Compartilhado  [seção C.2]
GDRIVE_FOLDER_ID=COLE_O_ID_DA_PASTA_AQUI

# Opcional — diretório de saída do PDF (default: diretório atual)
# REPORT_OUT_DIR=$HOME/Documents/Reports
